        border-bottom: 3px solid #1a4484;
        padding-bottom: 8px;
        margin-top: 0;
    }
    h2 {
        color: #0A1E2E;
        font-size: 16pt;
        border-bottom: 1.5px solid #cbd5e1;
        padding-bottom: 5px;
        margin-top: 25pt;
    }
    h3 {
        color: #1a4484;
        font-size: 13pt;
        margin-top: 15pt;
    }
    p, li {
        font-size: 11pt;
        color: #334155;
    }
    .badge {
        background-color: #e0f2f7;
        color: #1a4484;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 9.5pt;
    }
    table {
        width: 100%;
        border-collapse: collapse;
